    <!-- Developer Tools Section -->
    <section id="tools" class="py-20 bg-gray-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-16">
          <h2 class="text-3xl sm:text-4xl font-bold text-gray-900 mb-4">
            Complete Developer Toolkit
          </h2>
          <p class="text-xl text-gray-600 max-w-3xl mx-auto">
            Everything you need for modern web development. All tools work offline and respect your privacy.
          </p>
        </div>

        <!-- Tools Categories -->
        <div class="space-y-12">
          <!-- Generate Tools -->
          <div>
            <h3 class="text-2xl font-bold text-gray-900 mb-6 flex items-center">
              <svg class="w-8 h-8 text-indigo-600 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 100 4m0-4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 100 4m0-4v2m0-6V4"></path>
              </svg>
              Generators & Utilities
            </h3>
            <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
              <a href="/web-tools.html#/uuid" class="card-hover bg-white rounded-xl p-6 shadow-sm border border-gray-200 group">
                <div class="flex items-center mb-3">
                  <svg class="tool-icon text-blue-600 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 20l4-16m2 16l4-16M6 9h14M4 15h14"></path>
                  </svg>
                  <h4 class="font-semibold text-gray-900 group-hover:text-blue-600">UUID Generator</h4>
                </div>
                <p class="text-sm text-gray-600">Generate unique identifiers</p>
              </a>
              
              <a href="/web-tools.html#/password" class="card-hover bg-white rounded-xl p-6 shadow-sm border border-gray-200 group">
                <div class="flex items-center mb-3">
                  <svg class="tool-icon text-green-600 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"></path>
                  </svg>
                  <h4 class="font-semibold text-gray-900 group-hover:text-green-600">Password Generator</h4>
                </div>
                <p class="text-sm text-gray-600">Secure password creation</p>
              </a>
              
              <a href="/web-tools.html#/hasher" class="card-hover bg-white rounded-xl p-6 shadow-sm border border-gray-200 group">
                <div class="flex items-center mb-3">
                  <svg class="tool-icon text-purple-600 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path>
                  </svg>
                  <h4 class="font-semibold text-gray-900 group-hover:text-purple-600">Hash Generator</h4>
                </div>
                <p class="text-sm text-gray-600">MD5, SHA256, SHA512 hashing</p>
              </a>
              
              <a href="/web-tools.html#/ipsum" class="card-hover bg-white rounded-xl p-6 shadow-sm border border-gray-200 group">
