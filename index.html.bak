    <!-- About Section -->
    <section id="about" class="py-20 bg-white">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid lg:grid-cols-2 gap-16 items-center">
          <div>
            <h2 class="text-3xl sm:text-4xl font-bold text-gray-900 mb-6">
              Built for Developers,
              <span class="text-indigo-600">By Developers</span>
            </h2>
            <div class="space-y-6 text-lg text-gray-600">
              <p>
                Developers daily use numerous small utility programs that impose security and privacy risks. 
                It's also time-consuming to search and open each tool separately.
              </p>
              <p>
                <strong class="text-gray-900">Mini Dev Tools</strong> aims to recreate these utilities in a single 
                app/website/extension that doesn't collect any of your data. All features are free now and will be free forever.
              </p>
              <p>
                We're open source and welcome collaboration. Our goal is to make developers' lives easier 
                while maintaining the highest standards of privacy and security.
              </p>
            </div>
            
            <!-- Features List -->
            <div class="mt-8 grid sm:grid-cols-2 gap-4">
              <div class="flex items-center space-x-3">
                <svg class="w-5 h-5 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                </svg>
                <span class="text-gray-700 font-medium">100% Free</span>
              </div>
              <div class="flex items-center space-x-3">
                <svg class="w-5 h-5 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
