            </div>
          </div>

          <!-- Color Tools -->
          <div>
            <h3 class="text-2xl font-bold text-gray-900 mb-6 flex items-center">
              <svg class="w-8 h-8 text-indigo-600 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v1m0 0h6m0 0v6m0 0a2 2 0 012 2v6a2 2 0 01-2 2h-6a2 2 0 01-2-2v-1m0 0H9a2 2 0 01-2-2V9a2 2 0 012-2h2m0 0V5a2 2 0 012-2h4a2 2 0 012 2v2m0 0v6a2 2 0 01-2 2h-2"></path>
              </svg>
              Color & Design
