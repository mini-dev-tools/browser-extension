            <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
              <a href="/web-tools.html#/base64" class="card-hover bg-white rounded-xl p-6 shadow-sm border border-gray-200 group">
                <div class="flex items-center mb-3">
                  <svg class="tool-icon text-teal-600 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                  </svg>
                  <h4 class="font-semibold text-gray-900 group-hover:text-teal-600">Base64 Encoder</h4>
