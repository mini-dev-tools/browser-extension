{
  "name": "mini-dev-tools",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "build.bak": "vue-tsc --noEmit && vite build && cp public/manifest.json dist/manifest.json && cp public/background.js public/offscreen.html public/offscreen.js public/content.js dist/",
    "preview": "vite preview",
    "build:analyze": "vite build --mode analyze",
    "analyze": "vite-bundle-visualizer",
    "package": "cd dist && zip -r ../chrome-extension.zip . -x '*.DS_Store' -x '__MACOSX/*' -x '.vite/*' -x 'Archive.zip'"
  },
  "dependencies": {
    "@ckpack/vue-color": "^1.6.0",
    "@types/chrome": "^0.0.326",
    "@types/crypto-js": "^4.2.2",
    "@types/html-minifier-terser": "^7.0.2",
    "@unovis/ts": "^1.5.2",
    "@unovis/vue": "^1.5.2",
    "@vee-validate/zod": "^4.15.0",
    "@vueuse/core": "^13.3.0",
    "axios": "^1.9.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "crypto-js": "^4.2.0",
    "embla-carousel-vue": "^8.6.0",
    "html-minifier-terser": "^7.2.0",
    "js-yaml": "^4.1.0",
    "lorem-ipsum": "^2.0.8",
    "lucide-vue-next": "^0.511.0",
    "md-editor-v3": "^5.6.0",
    "minify": "^14.0.0",
    "pinia": "^3.0.2",
    "postcss-import": "^16.1.0",
    "radix-vue": "^1.9.17",
    "reka-ui": "^2.3.0",
    "swagger-ui-dist": "^5.22.0",
    "tailwind-merge": "^3.3.0",
    "tailwindcss-animate": "^1.0.7",
    "uuid": "^11.1.0",
    "vaul-vue": "^0.4.1",
    "vee-validate": "^4.15.0",
    "vue": "^3.5.16",
    "vue-draggable-plus": "^0.6.0",
    "vue-router": "^4.5.1",
    "vue-sonner": "^2.0.0",
    "vue-tsc": "^2.2.10",
    "vue3-ace-editor": "^2.2.4",
    "vuedraggable": "^2.24.3",
    "vuex": "^4.1.0",
    "zod": "^3.25.42"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.15.29",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-vue": "^5.2.4",
    "autoprefixer": "^10.4.21",
    "brace": "^0.11.1",
    "postcss": "^8.5.4",
    "prettier": "^3.5.3",
    "rollup-plugin-visualizer": "^6.0.1",
    "sass": "^1.89.1",
    "shadcn-vue": "^2.2.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.8.3",
    "unplugin-auto-import": "^19.3.0",
    "unplugin-vue-components": "^28.7.0",
    "vite": "^6.3.5",
    "vite-bundle-visualizer": "^1.2.1"
  }
}
